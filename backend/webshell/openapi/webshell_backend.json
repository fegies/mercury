{
  "openapi": "3.1.1",
  "info": {
    "title": "webshell | backend",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auctions": {
      "post": {
        "tags": [
          "Auction"
        ],
        "summary": "Creates a new auction and returns its id.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuctionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuctionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuctionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Auction"
        ],
        "summary": "Lists all auctions.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuctionSummary"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuctionSummary"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuctionSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}": {
      "patch": {
        "tags": [
          "Auction"
        ],
        "summary": "Updates the mutable fields of an auction. Closed auctions cannot be updated.\nThe closure time is updated via a dedicated extension endpoint below.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuctionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuctionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuctionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Auction"
        ],
        "summary": "Returns a single auction by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuctionSummary"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuctionSummary"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuctionSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}/extend-close": {
      "post": {
        "tags": [
          "Auction"
        ],
        "summary": "Extends the closure time of an open auction. The new closure time must be later than\nthe current one; the closure date can only be moved further out, never closer.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendCloseRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendCloseRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendCloseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}/images": {
      "post": {
        "tags": [
          "Auction"
        ],
        "summary": "Adds new images to an existing auction.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/IFormFile"
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}/images/{imageId}": {
      "delete": {
        "tags": [
          "Auction"
        ],
        "summary": "Removes an image from an auction.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "imageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}/close": {
      "post": {
        "tags": [
          "Auction"
        ],
        "summary": "Closes an auction permanently.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}/cancel": {
      "post": {
        "tags": [
          "Auction"
        ],
        "summary": "Cancels an open auction. The auction is closed permanently without a winner.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{id}/bid": {
      "post": {
        "tags": [
          "Auction"
        ],
        "summary": "Places a maximum bid on an auction and returns the resulting bid state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BidRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BidRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BidRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BidResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auctions/{auctionId}/images/{imageId}": {
      "get": {
        "tags": [
          "Auction"
        ],
        "summary": "Serves an auction image by id.",
        "parameters": [
          {
            "name": "auctionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "imageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/stream": {
      "get": {
        "tags": [
          "Live"
        ],
        "summary": "Streams live events to the signed-in user as server-sent events:\ntargeted notifications (outbid, won, cancelled) and broadcast pings\ntelling clients that an auction changed and should be refetched.\nTransient by design — only events committed while the stream is open\nare delivered; clients reconnect automatically.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/LiveEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/profilepictures/{id}": {
      "get": {
        "tags": [
          "ProfilePicture"
        ],
        "summary": "Serves a profile picture by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/userinfo/me": {
      "get": {
        "tags": [
          "UserInfo"
        ],
        "summary": "Return information about the currently signed in user.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuctionSummary": {
        "required": [
          "id",
          "title",
          "description",
          "minimumPrice",
          "closureTime",
          "isClosed",
          "isCancelled",
          "isPublished",
          "imageUrls"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "minimumPrice": {
            "type": "number",
            "format": "double"
          },
          "closureTime": {
            "type": "string",
            "format": "date-time"
          },
          "isClosed": {
            "type": "boolean"
          },
          "isCancelled": {
            "type": "boolean"
          },
          "isPublished": {
            "type": "boolean"
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentBid": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "myHighest": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "isHighestBidder": {
            "type": "boolean"
          }
        }
      },
      "BidRequest": {
        "required": [
          "maximumAmount"
        ],
        "type": "object",
        "properties": {
          "maximumAmount": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "BidResult": {
        "required": [
          "currentBid",
          "myHighest",
          "isHighestBidder"
        ],
        "type": "object",
        "properties": {
          "currentBid": {
            "type": "number",
            "format": "double"
          },
          "myHighest": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "isHighestBidder": {
            "type": "boolean"
          }
        }
      },
      "CreateAuctionRequest": {
        "required": [
          "title",
          "description",
          "minimumPrice",
          "closureTime",
          "isPublished"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "minimumPrice": {
            "type": "number",
            "format": "double"
          },
          "closureTime": {
            "type": "string",
            "format": "date-time"
          },
          "isPublished": {
            "type": "boolean"
          }
        }
      },
      "ExtendCloseRequest": {
        "required": [
          "closureTime"
        ],
        "type": "object",
        "properties": {
          "closureTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "LiveEvent": {
        "required": [
          "kind",
          "type",
          "auctionId",
          "title",
          "price"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/LiveEventKind"
          },
          "type": {
            "$ref": "#/components/schemas/LiveEventType"
          },
          "auctionId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "price": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "LiveEventKind": {
        "enum": [
          "Notification",
          "AuctionUpdated"
        ]
      },
      "LiveEventType": {
        "enum": [
          "Outbid",
          "Won",
          "Cancelled",
          "BidPlaced",
          "Closed",
          "Extended"
        ]
      },
      "Me": {
        "required": [
          "userinfo"
        ],
        "type": "object",
        "properties": {
          "userinfo": {
            "description": "The current user.",
            "$ref": "#/components/schemas/UserInfo"
          },
          "canStartAuctions": {
            "type": "boolean",
            "description": "A boolean detailing if the current user can start and manage auctions"
          }
        },
        "description": "An object describing the current user."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateAuctionRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "minimumPrice": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "isPublished": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "UserInfo": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "my user id"
          },
          "name": {
            "type": "string",
            "description": "display name"
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email address"
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Profile picture url"
          }
        },
        "description": "An object describing a current user"
      }
    }
  },
  "tags": [
    {
      "name": "Auction"
    },
    {
      "name": "Live"
    },
    {
      "name": "ProfilePicture"
    },
    {
      "name": "UserInfo"
    }
  ]
}